# Server Credentials (required and must be distinct):
AD_SERVER__HOST_PASSWORD=choose-a-strong-host-password
AD_SERVER__PLAYER_PASSWORD=choose-a-distinct-player-password

# LLM Provider Configuration:
# For local OpenAI-compatible backends (e.g. llama.cpp, vLLM, Ollama):
AD_LLM__PROVIDER=compatible
AD_LLM__API_KEY=sk-no-key-required
# Leave the endpoint unset to use the default: http://localhost:8033/v1 when running directly,
# or http://host.docker.internal:8033/v1 under Docker Compose. Inside a container, localhost
# refers to the container itself, not the machine running the model server.
# AD_LLM__ENDPOINT=http://localhost:8033/v1

# If using direct OpenAI as the LLM provider:
# AD_LLM__PROVIDER=openai
# AD_OPENAI_API_KEY=your-openai-api-key-here

# Optional audio.cpp / speech server settings (endpoint defaults follow the same rule as above):
AD_AUDIO__ENABLED=false
# AD_AUDIO__ENDPOINT=http://localhost:8080
